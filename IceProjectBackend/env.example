# Server Configuration
NODE_ENV=development
PORT=3000
HOST=localhost

# Database Configuration
#MONGODB_URI=mongodb://localhost:27017/sales_system
MONGODB_URI=mongodb+srv://alikhan123:w7uuY0dzgDPf2SkQ@cluster0.vketuch.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0
MONGODB_URI_TEST=mongodb://localhost:27017/sales_system_test

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Redis Configuration (for BullMQ)
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Redis SSL/TLS Configuration (for cloud Redis providers)
REDIS_SSL_VERIFY=true
REDIS_TLS_VERSION=TLS_method

# QuickBooks Online Configuration
QBO_CLIENT_ID=your-qbo-client-id
QBO_CLIENT_SECRET=your-qbo-client-secret
QBO_REDIRECT_URI=http://localhost:3000/qbo/oauth/callback
QBO_ENVIRONMENT=sandbox
QBO_SCOPE=com.intuit.quickbooks.accounting

# QuickBooks SSL/TLS Configuration
# Set to 'false' only for debugging SSL issues (NOT recommended for production)
QBO_SSL_VERIFY=true
# Use TLS_method for maximum compatibility with QuickBooks API
# TLS_method automatically selects the best available TLS version
QBO_TLS_VERSION=TLS_method

# Cloud Platform Detection (for enhanced SSL configuration)
# Set to 'true' if deploying to cloud platforms like Render, Heroku, Vercel
RENDER=false
HEROKU=false
VERCEL=false

# Payment Provider Configuration
PAYMENT_PROVIDER=dummy
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# Logging Configuration
LOG_LEVEL=info
LOG_PRETTY_PRINT=true

# Security Configuration
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# File Upload Configuration
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads

# Maps API (for future route generation)
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Frontend URL (used in password-reset email links)
FRONTEND_URL=http://localhost:3000

# Email Configuration (Resend)
# Get your API key from: https://resend.com/api-keys
RESEND_API_KEY=your-resend-api-key

# From Email Address (Optional but Recommended)
# Your domain 'icemansice.com' is verified in Resend!
# You can now use any email address @icemansice.com (the email doesn't need to exist)
# Recommended options:
RESEND_FROM_EMAIL=orders@icemansice.com
# RESEND_FROM_EMAIL=notifications@icemansice.com
# RESEND_FROM_EMAIL=noreply@icemansice.com
# If not set, defaults to 'onboarding@resend.dev'

# Sync Configuration
SYNC_BATCH_SIZE=100
SYNC_CONFLICT_RESOLUTION=last-write-wins
